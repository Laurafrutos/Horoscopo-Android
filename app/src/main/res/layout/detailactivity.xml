<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:text="ARIES"
        android:textColor="#1E1E2E"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <!-- CORRECCIÓN: Etiqueta correctamente cerrada e ID añadido para que Kotlin la encuentre -->
    <ImageView
        android:id="@+id/imageViewHoroscope"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/aries_icon" />

    <!-- CORRECCIÓN: Añadido el ID al TextView para que puedas cambiar el texto dinámicamente -->
    <TextView
        android:id="@+id/textViewDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="este es el texto de aries"
        android:textColor="#1E1E2E"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
